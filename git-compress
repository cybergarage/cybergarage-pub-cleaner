#!/usr/bin/env python3

import argparse
import datetime as dt
import os
import re
import shutil
import subprocess
import sys
import tempfile
import termios
import tty
from dataclasses import dataclass
from pathlib import Path
from typing import Iterable, Optional, Sequence


IMAGE_EXTS = {".png", ".jpg", ".jpeg"}
DEFAULT_PUSH_CHUNK_SIZE = 1000


@dataclass(frozen=True)
class RunResult:
    returncode: int
    stdout: str
    stderr: str


@dataclass(frozen=True)
class Invocation:
    repo_name: str
    target_rels: list[str]
    remote_url: str
    branch: str
    current_repo: Optional[Path]


def eprint(message: str) -> None:
    print(message, file=sys.stderr)


def read_confirmation_key(prompt: str) -> str:
    print(prompt, end="", flush=True)
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        while True:
            answer = sys.stdin.read(1).lower()
            if answer in {"y", "n"}:
                print(answer)
                return answer
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)


def run(
    args: list[str],
    cwd: Optional[Path] = None,
    check: bool = True,
    input_text: Optional[str] = None,
) -> RunResult:
    proc = subprocess.run(
        args,
        cwd=str(cwd) if cwd else None,
        input=input_text,
        capture_output=True,
        text=True,
    )
    result = RunResult(proc.returncode, proc.stdout, proc.stderr)
    if check and proc.returncode != 0:
        details = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(f"command failed: {' '.join(args)}\n{details}")
    return result


def command_exists(command: str) -> bool:
    return shutil.which(command) is not None


def print_install_help(missing: list[str]) -> None:
    eprint("Error: required command(s) not found: " + ", ".join(missing))
    eprint("")
    eprint("Install examples:")
    eprint("  macOS Homebrew:")
    eprint("    brew install git git-filter-repo python")
    eprint("")
    eprint("  Ubuntu/Debian:")
    eprint("    sudo apt-get update")
    eprint("    sudo apt-get install -y git python3 git-filter-repo")
    eprint("")
    eprint("  If git-filter-repo is unavailable from apt:")
    eprint("    python3 -m pip install --user git-filter-repo")
    eprint("")
    eprint("No commands were installed by this script.")


def require_commands() -> None:
    required = ["git", "git-filter-repo", "python3"]
    missing = [cmd for cmd in required if not command_exists(cmd)]
    if missing:
        print_install_help(missing)
        raise SystemExit(1)


def maybe_repo_root() -> Optional[Path]:
    result = run(["git", "rev-parse", "--show-toplevel"], check=False)
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return Path(result.stdout.strip()).resolve()


def current_branch(repo: Path) -> str:
    result = run(["git", "symbolic-ref", "--quiet", "--short", "HEAD"], cwd=repo, check=False)
    branch = result.stdout.strip()
    if result.returncode != 0 or not branch:
        raise RuntimeError("current repository must be on a branch, not detached HEAD")
    return branch


def origin_url(repo: Path) -> str:
    result = run(["git", "remote", "get-url", "origin"], cwd=repo, check=False)
    if result.returncode != 0 or not result.stdout.strip():
        raise RuntimeError("origin remote is not configured")
    return result.stdout.strip()


def ensure_clean(repo: Path) -> None:
    result = run(["git", "status", "--porcelain=v1"], cwd=repo)
    if result.stdout.strip():
        raise RuntimeError(
            "working tree is not clean. Commit, stash, or remove these changes first:\n"
            + result.stdout
        )


def ensure_local_matches_remote(repo: Path, branch: str) -> None:
    print(f"Fetching origin/{branch} for safety check...")
    run(["git", "fetch", "origin", branch], cwd=repo)
    local = run(["git", "rev-parse", "HEAD"], cwd=repo).stdout.strip()
    remote = run(["git", "rev-parse", f"origin/{branch}"], cwd=repo).stdout.strip()
    if local != remote:
        raise RuntimeError(
            f"local HEAD does not match origin/{branch}.\n"
            "Run git pull first, or resolve the difference before git-compress."
        )


def normalize_remote(repo_name: str, org: str) -> str:
    if repo_name.startswith(("git@", "https://", "ssh://")):
        return repo_name
    if repo_name.endswith(".git") and "/" in repo_name:
        return repo_name
    return f"git@github.com:{org}/{repo_name}.git"


def repo_name_from_remote(remote: str, fallback: str) -> str:
    name = remote.rstrip("/").removesuffix(".git").split("/")[-1]
    return name if name else fallback


def ensure_target_arg(target_arg: str) -> str:
    target = Path(target_arg)
    if target.is_absolute():
        raise RuntimeError("target directory must be a repository-relative path")
    rel = target.as_posix().strip("/")
    if not rel or rel == ".":
        raise RuntimeError("target directory must not be the repository root")
    if rel == ".git" or rel.startswith(".git/"):
        raise RuntimeError("target directory must not be inside .git")
    return rel


def unique_targets(target_args: Sequence[str]) -> list[str]:
    targets: list[str] = []
    seen: set[str] = set()
    for target_arg in target_args:
        target = ensure_target_arg(target_arg)
        if target not in seen:
            targets.append(target)
            seen.add(target)
    return targets


def ensure_targets_exist(repo: Path, target_rels: Sequence[str]) -> None:
    for target_rel in target_rels:
        target = repo / target_rel
        if not target.exists() or not target.is_dir():
            raise RuntimeError(f"target directory not found: {target_rel}")


def resolve_invocation(args: argparse.Namespace) -> Invocation:
    cwd_repo = maybe_repo_root()

    if args.remote_url:
        if not args.items:
            raise RuntimeError("usage with --remote-url: git-compress --remote-url <url> <target-dir> [...]")
        target_rels = unique_targets(args.items)
        branch = args.branch or "main"
        remote = args.remote_url
        repo_name = repo_name_from_remote(remote, "repository")
        return Invocation(repo_name, target_rels, remote, branch, None)

    if cwd_repo and len(args.items) >= 1:
        branch = args.branch or current_branch(cwd_repo)
        remote = origin_url(cwd_repo)
        repo_name = repo_name_from_remote(remote, cwd_repo.name)

        if len(args.items) == 1:
            target_rels = unique_targets(args.items)
            ensure_targets_exist(cwd_repo, target_rels)
            return Invocation(repo_name, target_rels, remote, branch, cwd_repo)

        first_as_target = ensure_target_arg(args.items[0])
        if (cwd_repo / first_as_target).is_dir():
            target_rels = unique_targets(args.items)
            ensure_targets_exist(cwd_repo, target_rels)
            return Invocation(repo_name, target_rels, remote, branch, cwd_repo)

    if len(args.items) >= 2:
        repo_name = args.items[0]
        target_rels = unique_targets(args.items[1:])
        remote = normalize_remote(repo_name, args.org)
        branch = args.branch or "main"
        return Invocation(repo_name_from_remote(remote, repo_name), target_rels, remote, branch, None)

    raise RuntimeError("usage: git-compress [repo-name-or-url] <target-dir> [...]")


def slugify(value: str) -> str:
    slug = re.sub(r"[^A-Za-z0-9._-]+", "-", value.strip("/"))
    slug = slug.strip("-._")
    return slug[:80] if slug else "target"


def target_label(target_rels: Sequence[str]) -> str:
    if len(target_rels) == 1:
        return target_rels[0]
    return f"{len(target_rels)}-targets"


def work_dir_prefix(invocation: Invocation) -> str:
    timestamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    repo_slug = slugify(invocation.repo_name)
    target_slug = slugify(target_label(invocation.target_rels))
    return f"git-compress-{repo_slug}-{target_slug}-{timestamp}-"


def create_work_dir(invocation: Invocation, work_dir_arg: Optional[str]) -> Path:
    if work_dir_arg:
        work_dir = Path(work_dir_arg).resolve()
        if work_dir.exists():
            raise RuntimeError(f"work directory already exists: {work_dir}")
        work_dir.mkdir(parents=True)
        return work_dir

    return Path(tempfile.mkdtemp(prefix=work_dir_prefix(invocation), dir=Path.cwd()))


def write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")


def append_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fp:
        fp.write(text)


def capture_command(repo: Path, title: str, args: list[str], output_path: Path) -> str:
    result = run(args, cwd=repo, check=False)
    body = result.stdout
    if result.stderr:
        body += result.stderr
    block = f"$ {' '.join(args)}\n{body.rstrip()}\n"
    append_text(output_path, f"## {title}\n\n```text\n{block}```\n\n")
    return body


def record_repo_state(repo: Path, output_path: Path, heading: str) -> None:
    write_text(output_path, f"# {heading}\n\n")
    capture_command(repo, "du -sh .git", ["du", "-sh", ".git"], output_path)
    capture_command(repo, "git count-objects -vH", ["git", "count-objects", "-vH"], output_path)
    capture_command(repo, "git status", ["git", "status"], output_path)
    capture_command(repo, "git log --oneline -5", ["git", "log", "--oneline", "-5"], output_path)


def clone_remote(invocation: Invocation, work_dir: Path) -> tuple[Path, Path, str]:
    backup_dir = work_dir / f"{invocation.repo_name}.git"
    fresh_dir = work_dir / invocation.repo_name

    try:
        run(["git", "clone", "--mirror", invocation.remote_url, str(backup_dir)])
        run(
            [
                "git",
                "clone",
                "--branch",
                invocation.branch,
                "--single-branch",
                invocation.remote_url,
                str(fresh_dir),
            ]
        )
        expected_oid = run(["git", "rev-parse", "HEAD"], cwd=fresh_dir).stdout.strip()
    except RuntimeError:
        shutil.rmtree(backup_dir, ignore_errors=True)
        shutil.rmtree(fresh_dir, ignore_errors=True)
        raise

    return backup_dir, fresh_dir, expected_oid


def is_image_path(path: str) -> bool:
    return Path(path).suffix.lower() in IMAGE_EXTS


def parse_ls_tree_z(data: str) -> list[tuple[str, str]]:
    entries: list[tuple[str, str]] = []
    for record in data.split("\0"):
        if not record:
            continue
        meta, path = record.split("\t", 1)
        parts = meta.split()
        if len(parts) >= 3 and parts[1] == "blob":
            entries.append((parts[2], path))
    return entries


def head_image_blobs(repo: Path, pathspecs: Optional[Sequence[str]] = None) -> list[tuple[str, str]]:
    args = ["git", "ls-tree", "-rz", "-r", "HEAD"]
    if pathspecs:
        args.extend(["--", *pathspecs])
    result = run(args, cwd=repo)
    return [(oid, path) for oid, path in parse_ls_tree_z(result.stdout) if is_image_path(path)]


def historical_image_blobs(repo: Path, target_rels: Sequence[str]) -> dict[str, set[str]]:
    result = run(["git", "rev-list", "--objects", "--all", "--", *target_rels], cwd=repo)
    blobs: dict[str, set[str]] = {}
    object_ids: set[str] = set()

    for line in result.stdout.splitlines():
        if not line:
            continue
        cols = line.split(maxsplit=1)
        if len(cols) != 2:
            continue
        oid, path = cols
        if not is_image_path(path):
            continue
        blobs.setdefault(oid, set()).add(path)
        object_ids.add(oid)

    types = object_types(repo, sorted(object_ids))
    return {oid: paths for oid, paths in blobs.items() if types.get(oid) == "blob"}


def object_types(repo: Path, object_ids: list[str]) -> dict[str, str]:
    if not object_ids:
        return {}
    result = run(
        ["git", "cat-file", "--batch-check=%(objectname) %(objecttype)"],
        cwd=repo,
        input_text="\n".join(object_ids) + "\n",
    )
    types: dict[str, str] = {}
    for line in result.stdout.splitlines():
        cols = line.split()
        if len(cols) >= 2:
            types[cols[0]] = cols[1]
    return types


def object_sizes(repo: Path, object_ids: Iterable[str]) -> dict[str, int]:
    ids = sorted(set(object_ids))
    if not ids:
        return {}
    result = run(
        ["git", "cat-file", "--batch-check=%(objectname) %(objecttype) %(objectsize)"],
        cwd=repo,
        input_text="\n".join(ids) + "\n",
    )
    sizes: dict[str, int] = {}
    for line in result.stdout.splitlines():
        cols = line.split()
        if len(cols) >= 3 and cols[1] == "blob":
            sizes[cols[0]] = int(cols[2])
    return sizes


def classify_blobs(repo: Path, target_rels: Sequence[str], report_dir: Path) -> tuple[set[str], int, int, int, bool]:
    head_target = head_image_blobs(repo, target_rels)
    head_all = head_image_blobs(repo)
    historical = historical_image_blobs(repo, target_rels)

    protected_head_blob_ids = {oid for oid, _ in head_all}
    head_target_blob_ids = {oid for oid, _ in head_target}
    strip_blob_ids = set(historical) - protected_head_blob_ids
    protected_ok = not (head_target_blob_ids & strip_blob_ids)

    strip_sizes = object_sizes(repo, strip_blob_ids)
    strip_size_total = sum(strip_sizes.values())

    write_text(report_dir / "head-target-images.tsv", format_blob_paths(head_target))
    write_text(report_dir / "head-all-images.tsv", format_blob_paths(head_all))
    write_text(report_dir / "historical-target-image-blobs.tsv", format_historical_blobs(historical))
    write_text(report_dir / "strip-blob-ids.txt", "\n".join(sorted(strip_blob_ids)) + ("\n" if strip_blob_ids else ""))
    write_text(report_dir / "strip-blob-report.tsv", format_strip_blobs(historical, strip_sizes, strip_blob_ids))

    return strip_blob_ids, strip_size_total, len(head_target), len(head_target_blob_ids), protected_ok


def format_blob_paths(entries: list[tuple[str, str]]) -> str:
    lines = ["blob_id\tpath\n"]
    for oid, path in sorted(entries, key=lambda item: (item[1], item[0])):
        lines.append(f"{oid}\t{path}\n")
    return "".join(lines)


def format_historical_blobs(blobs: dict[str, set[str]]) -> str:
    lines = ["blob_id\tpaths\n"]
    for oid in sorted(blobs):
        lines.append(f"{oid}\t{';'.join(sorted(blobs[oid]))}\n")
    return "".join(lines)


def format_strip_blobs(blobs: dict[str, set[str]], sizes: dict[str, int], strip_ids: set[str]) -> str:
    lines = ["blob_id\tsize_bytes\tpaths\n"]
    for oid in sorted(strip_ids):
        lines.append(f"{oid}\t{sizes.get(oid, 0)}\t{';'.join(sorted(blobs.get(oid, [])))}\n")
    return "".join(lines)


def run_filter_repo(repo: Path, strip_ids_file: Path, remote: str) -> None:
    if strip_ids_file.stat().st_size > 0:
        run(["git", "filter-repo", "--force", "--strip-blobs-with-ids", str(strip_ids_file)], cwd=repo)
    else:
        print("No historical JPEG/PNG blobs need stripping for the target directory.")

    remotes = run(["git", "remote"], cwd=repo).stdout.split()
    if "origin" not in remotes:
        run(["git", "remote", "add", "origin", remote], cwd=repo)

    run(["git", "reflog", "expire", "--expire=now", "--all"], cwd=repo)
    run(["git", "gc", "--prune=now", "--aggressive"], cwd=repo)


def ask_confirmation(args: argparse.Namespace, invocation: Invocation, fresh: Path) -> None:
    if args.yes or args.no_push:
        return
    if not sys.stdin.isatty():
        raise RuntimeError("confirmation required; rerun with --yes in non-interactive mode")

    print("")
    print("This will rewrite remote history.")
    print(f"  remote: {invocation.remote_url}")
    print(f"  branch: {invocation.branch}")
    print(f"  cloned repository to push: {fresh}")
    print("")
    answer = read_confirmation_key("Press 'y' to continue, 'n' to cancel: ")
    if answer != "y":
        raise RuntimeError("aborted by user")


def cleanup_temp_refs(repo: Path, temp_refs: Sequence[str]) -> None:
    for ref in reversed(temp_refs):
        result = run(["git", "push", "origin", f":{ref}"], cwd=repo, check=False)
        if result.returncode != 0:
            details = result.stderr.strip() or result.stdout.strip()
            eprint(f"Warning: failed to delete temporary ref {ref}: {details}")


def preload_rewritten_history(repo: Path, chunk_size: int, temp_refs: list[str]) -> None:
    if chunk_size <= 0:
        print("Skipping temporary preload branches because --push-chunk-size=0.")
        return

    commits = run(["git", "rev-list", "--topo-order", "--reverse", "HEAD"], cwd=repo).stdout.splitlines()
    if not commits:
        return

    checkpoints = [commits[index] for index in range(chunk_size - 1, len(commits), chunk_size)]
    if checkpoints[-1] != commits[-1]:
        checkpoints.append(commits[-1])

    run_id = dt.datetime.now().strftime("%Y%m%d%H%M%S") + f"-{os.getpid()}"
    print(
        "Preloading rewritten history through temporary branches "
        f"({len(checkpoints)} pushes, chunk size {chunk_size})..."
    )
    for index, oid in enumerate(checkpoints, start=1):
        temp_ref = f"refs/heads/git-compress-preload-{run_id}-{index:04d}"
        print(f"  preload {index}/{len(checkpoints)}: {temp_ref}")
        run(["git", "push", "origin", f"{oid}:{temp_ref}"], cwd=repo)
        temp_refs.append(temp_ref)


def push_rewritten_history(repo: Path, branch: str, expected_old_oid: str, push_chunk_size: int) -> None:
    temp_refs: list[str] = []
    lease = f"--force-with-lease=refs/heads/{branch}:{expected_old_oid}"
    try:
        preload_rewritten_history(repo, push_chunk_size, temp_refs)
        print("Pushing final branch update with --force-with-lease...")
        run(["git", "push", lease, "origin", f"HEAD:{branch}"], cwd=repo)
    finally:
        if temp_refs:
            print("Deleting temporary preload branches...")
            cleanup_temp_refs(repo, temp_refs)


def build_summary(
    path: Path,
    invocation: Invocation,
    work_dir: Path,
    backup_dir: Path,
    fresh_dir: Path,
    old_branch_head: str,
    before_state: Path,
    after_state: Path,
    push_chunk_size: int,
    strip_count: int,
    strip_size: int,
    head_image_file_count: int,
    head_image_blob_count: int,
    protected_ok: bool,
    pushed: bool,
) -> None:
    lines = [
        "# git-compress summary",
        "",
        f"- Repository: `{invocation.repo_name}`",
        f"- Target directories: `{', '.join(invocation.target_rels)}`",
        f"- Branch: `{invocation.branch}`",
        f"- Remote: `{invocation.remote_url}`",
        f"- Work directory: `{work_dir}`",
        f"- Mirror backup: `{backup_dir}`",
        f"- Rewritten clone: `{fresh_dir}`",
        f"- Branch HEAD before rewrite: `{old_branch_head}`",
        f"- Rewritten history pushed: `{str(pushed).lower()}`",
        f"- Temporary preload push chunk size: `{push_chunk_size}`",
        f"- JPEG/PNG blob IDs selected for removal: `{strip_count}`",
        f"- Approximate historical blob bytes selected for removal: `{strip_size}`",
        f"- HEAD JPEG/PNG files under target: `{head_image_file_count}`",
        f"- HEAD JPEG/PNG unique blobs under target: `{head_image_blob_count}`",
        f"- HEAD target blobs absent from strip list: `{str(protected_ok).lower()}`",
        "",
        "## State Reports",
        "",
        f"- Before cleanup: `{before_state}`",
        f"- After cleanup: `{after_state}`",
        "",
        "## Generated Files",
        "",
        "- `head-target-images.tsv`",
        "- `head-all-images.tsv`",
        "- `historical-target-image-blobs.tsv`",
        "- `strip-blob-ids.txt`",
        "- `strip-blob-report.tsv`",
        "",
        "## Next Steps",
        "",
        "1. In existing clones, run `git pull --ff-only` first.",
        "2. If pull reports divergent history, re-clone or reset to the rewritten remote branch.",
        "3. Run `git-sizer --verbose` to verify the repository size.",
        "",
    ]
    write_text(path, "\n".join(lines))


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Remove old JPEG/PNG blobs under target directories from Git history "
            "in a freshly cloned repository and push the cleaned branch."
        )
    )
    parser.add_argument(
        "items",
        nargs="+",
        help=(
            "Either <target-dir> [...] inside the current repository, or "
            "<repo-name-or-url> <target-dir> [...] outside it"
        ),
    )
    parser.add_argument(
        "--org",
        default="cybergarage",
        help="GitHub organization used when repo name is not a URL",
    )
    parser.add_argument(
        "--branch",
        help="branch to clean (default: current branch inside a repo, otherwise main)",
    )
    parser.add_argument(
        "--work-dir",
        help="directory for reports, mirror backup, and cloned repository (default: current directory)",
    )
    parser.add_argument(
        "--remote-url",
        help="remote URL to clone and push",
    )
    parser.add_argument(
        "--push-chunk-size",
        default=DEFAULT_PUSH_CHUNK_SIZE,
        type=int,
        help=(
            "number of rewritten commits per temporary preload push "
            f"(default: {DEFAULT_PUSH_CHUNK_SIZE}; use 0 to disable)"
        ),
    )
    parser.add_argument(
        "--no-push",
        action="store_true",
        help="do everything except pushing rewritten history",
    )
    parser.add_argument(
        "--yes",
        action="store_true",
        help="skip the rewrite-history confirmation prompt",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if args.push_chunk_size < 0:
        raise RuntimeError("--push-chunk-size must be 0 or greater")
    require_commands()

    invocation = resolve_invocation(args)
    if invocation.current_repo:
        ensure_clean(invocation.current_repo)
        ensure_local_matches_remote(invocation.current_repo, invocation.branch)

    work_dir = create_work_dir(invocation, args.work_dir)
    report_dir = work_dir / "reports"
    before_state = report_dir / "before-state.md"
    after_state = report_dir / "after-state.md"
    summary = work_dir / "summary.md"

    print(f"Repository: {invocation.repo_name}")
    print(f"Target directories: {', '.join(invocation.target_rels)}")
    print(f"Branch: {invocation.branch}")
    print(f"Remote: {invocation.remote_url}")
    print(f"Work directory: {work_dir}")

    print("Creating mirror backup and clean working clone...")
    backup_dir, fresh_dir, expected_old_oid = clone_remote(invocation, work_dir)

    print("Recording cloned repository state...")
    record_repo_state(fresh_dir, before_state, "Before git-compress")

    print("Classifying JPEG/PNG blobs by blob ID...")
    strip_ids, strip_size, head_file_count, head_blob_count, protected_ok = classify_blobs(
        fresh_dir, invocation.target_rels, report_dir
    )
    if not protected_ok:
        raise RuntimeError("internal safety check failed: a HEAD target blob was selected for stripping")

    print("Running git-filter-repo in the cloned repository...")
    run_filter_repo(fresh_dir, report_dir / "strip-blob-ids.txt", invocation.remote_url)

    print("Recording post-cleanup repository state...")
    record_repo_state(fresh_dir, after_state, "After git-compress cleanup")

    pushed = False
    if args.no_push:
        print("Skipping push because --no-push was specified.")
    else:
        ask_confirmation(args, invocation, fresh_dir)
        print("Pushing rewritten history with temporary preload branches...")
        push_rewritten_history(fresh_dir, invocation.branch, expected_old_oid, args.push_chunk_size)
        pushed = True

    build_summary(
        summary,
        invocation,
        work_dir,
        backup_dir,
        fresh_dir,
        expected_old_oid,
        before_state,
        after_state,
        args.push_chunk_size,
        len(strip_ids),
        strip_size,
        head_file_count,
        head_blob_count,
        protected_ok,
        pushed,
    )

    print("")
    print("Done.")
    print(f"Summary: {summary}")
    print(f"Mirror backup: {backup_dir}")
    print(f"Rewritten clone: {fresh_dir}")
    if pushed:
        print("Existing clones can try `git pull --ff-only`.")
        print("If Git reports divergent history, re-clone or reset to the rewritten branch.")
    else:
        print("No push was performed.")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except RuntimeError as exc:
        eprint(f"Error: {exc}")
        raise SystemExit(1)
