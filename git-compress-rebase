#!/usr/bin/env python3

import argparse
import datetime as dt
import subprocess
import sys
from pathlib import Path
from typing import Optional


class CommandError(RuntimeError):
    pass


def run(args: list[str], cwd: Optional[Path] = None, check: bool = True) -> subprocess.CompletedProcess[str]:
    proc = subprocess.run(
        args,
        cwd=str(cwd) if cwd else None,
        capture_output=True,
        text=True,
    )
    if check and proc.returncode != 0:
        details = proc.stderr.strip() or proc.stdout.strip()
        raise CommandError(f"command failed: {' '.join(args)}\n{details}")
    return proc


def eprint(message: str) -> None:
    print(message, file=sys.stderr)


def repo_root() -> Path:
    result = run(["git", "rev-parse", "--show-toplevel"])
    return Path(result.stdout.strip()).resolve()


def current_branch(repo: Path) -> str:
    result = run(["git", "symbolic-ref", "--quiet", "--short", "HEAD"], cwd=repo)
    branch = result.stdout.strip()
    if not branch:
        raise CommandError("current repository must be on a branch, not detached HEAD")
    return branch


def ensure_clean(repo: Path) -> None:
    result = run(["git", "status", "--porcelain=v1"], cwd=repo)
    if result.stdout.strip():
        raise CommandError(
            "working tree is not clean. Commit, stash, or remove these changes first:\n"
            + result.stdout
        )


def ensure_commit(repo: Path, value: str) -> str:
    result = run(["git", "rev-parse", "--verify", f"{value}^{{commit}}"], cwd=repo)
    return result.stdout.strip()


def ensure_ancestor(repo: Path, ancestor: str, descendant: str, message: str) -> None:
    result = run(["git", "merge-base", "--is-ancestor", ancestor, descendant], cwd=repo, check=False)
    if result.returncode != 0:
        raise CommandError(message)


def unique_backup_name(repo: Path, requested: Optional[str]) -> str:
    if requested:
        name = requested
    else:
        stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
        name = f"backup-before-rebase-{stamp}"

    candidate = name
    suffix = 2
    while run(["git", "rev-parse", "--verify", "--quiet", candidate], cwd=repo, check=False).returncode == 0:
        candidate = f"{name}-{suffix}"
        suffix += 1
    return candidate


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Replay local commits created after an old pre-cleanup base onto "
            "the rewritten origin branch."
        )
    )
    parser.add_argument(
        "old_base",
        help="old branch HEAD before git-compress rewrote and pushed history",
    )
    parser.add_argument(
        "--branch",
        help="local branch to rebase (default: current branch)",
    )
    parser.add_argument(
        "--remote",
        default="origin",
        help="remote name to fetch from (default: origin)",
    )
    parser.add_argument(
        "--onto",
        help="target ref to rebase onto (default: <remote>/<branch>)",
    )
    parser.add_argument(
        "--backup-name",
        help="backup branch name (default: backup-before-rebase-YYYYMMDD-HHMMSS)",
    )
    parser.add_argument(
        "--no-fetch",
        action="store_true",
        help="do not fetch <remote>/<branch> before rebasing",
    )
    parser.add_argument(
        "--keep-backup",
        action="store_true",
        help="keep the temporary backup branch after a successful rebase",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    repo = repo_root()
    branch = args.branch or current_branch(repo)
    onto_ref = args.onto or f"{args.remote}/{branch}"

    ensure_clean(repo)

    if not args.no_fetch:
        print(f"Fetching {args.remote}/{branch}...")
        run(["git", "fetch", args.remote, branch], cwd=repo)

    old_base = ensure_commit(repo, args.old_base)
    onto_oid = ensure_commit(repo, onto_ref)
    branch_oid = ensure_commit(repo, branch)

    ensure_ancestor(
        repo,
        old_base,
        branch,
        f"old base is not an ancestor of {branch}: {old_base}",
    )

    local_count = int(run(["git", "rev-list", "--count", f"{old_base}..{branch}"], cwd=repo).stdout.strip())
    if local_count == 0:
        raise CommandError(
            f"no local commits found after old base {old_base}. "
            f"Nothing to replay onto {onto_ref}."
        )

    backup = unique_backup_name(repo, args.backup_name)
    print(f"Repository: {repo}")
    print(f"Branch: {branch} ({branch_oid})")
    print(f"Old base: {old_base}")
    print(f"Onto: {onto_ref} ({onto_oid})")
    print(f"Local commits to replay: {local_count}")
    print(f"Backup branch: {backup}")

    run(["git", "branch", backup, branch], cwd=repo)

    print("Rebasing local commits onto rewritten history...")
    run(["git", "rebase", "--onto", onto_ref, old_base, branch], cwd=repo)

    if args.keep_backup:
        print(f"Keeping backup branch: {backup}")
    else:
        print(f"Deleting backup branch after successful rebase: {backup}")
        run(["git", "branch", "-D", backup], cwd=repo)

    print("")
    print("Done.")
    print(run(["git", "status", "--short", "--branch"], cwd=repo).stdout.rstrip())
    print(run(["git", "log", "--oneline", "-5"], cwd=repo).stdout.rstrip())
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except CommandError as exc:
        eprint(f"Error: {exc}")
        raise SystemExit(1)
