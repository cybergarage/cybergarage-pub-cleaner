#!/usr/bin/env python3

import argparse
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Optional


@dataclass(frozen=True)
class RunResult:
    returncode: int
    stdout: str
    stderr: str


def run(args: list[str], cwd: Optional[Path] = None, check: bool = False) -> RunResult:
    proc = subprocess.run(
        args,
        cwd=str(cwd) if cwd else None,
        capture_output=True,
        text=True,
    )
    result = RunResult(proc.returncode, proc.stdout, proc.stderr)
    if check and proc.returncode != 0:
        details = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(f"command failed: {' '.join(args)}\n{details}")
    return result


def command_exists(command: str) -> bool:
    return shutil.which(command) is not None


def section(title: str) -> None:
    print("")
    print(f"## {title}")
    print("")


def command_block(args: list[str], cwd: Path, check: bool = False) -> RunResult:
    print(f"$ {' '.join(args)}")
    result = run(args, cwd=cwd, check=check)
    output = result.stdout
    if result.stderr:
        output += result.stderr
    if output.strip():
        print(output.rstrip())
    else:
        print("(no output)")
    if result.returncode != 0:
        print(f"(exit code: {result.returncode})")
    print("")
    return result


def repo_root() -> Path:
    result = run(["git", "rev-parse", "--show-toplevel"], check=True)
    return Path(result.stdout.strip()).resolve()


def read_refs(repo: Path) -> list[str]:
    result = run(["git", "for-each-ref", "--format=%(refname)"], cwd=repo, check=True)
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def summarize_refs(refs: list[str]) -> dict[str, int]:
    counts = {
        "heads": 0,
        "remotes": 0,
        "tags": 0,
        "stash": 0,
        "codex": 0,
        "other": 0,
    }
    for ref in refs:
        if ref.startswith("refs/heads/"):
            counts["heads"] += 1
        elif ref.startswith("refs/remotes/"):
            counts["remotes"] += 1
        elif ref.startswith("refs/tags/"):
            counts["tags"] += 1
        elif ref == "refs/stash":
            counts["stash"] += 1
        elif ref.startswith("refs/codex/"):
            counts["codex"] += 1
        else:
            counts["other"] += 1
    return counts


def print_ref_summary(repo: Path) -> None:
    refs = read_refs(repo)
    counts = summarize_refs(refs)

    print(f"total refs: {len(refs)}")
    print(f"branches: {counts['heads']}")
    print(f"remote-tracking refs: {counts['remotes']}")
    print(f"tags: {counts['tags']}")
    print(f"stash refs: {counts['stash']}")
    print(f"codex refs: {counts['codex']}")
    print(f"other refs: {counts['other']}")
    print("")

    if counts["stash"] or counts["codex"] or counts["other"]:
        print("WARN: git-sizer will include stash/codex/other refs when they are reachable.")
        print("      For git-compress verification, prefer the fresh rewritten clone.")
    elif counts["remotes"] == 0 and counts["heads"] == 1:
        print("OK: this looks like a small-ref fresh clone.")
    else:
        print("NOTE: refs look normal, but confirm git-sizer output for final judgment.")
    print("")


def print_remote_check(repo: Path, expected_remote: Optional[str]) -> None:
    result = run(["git", "remote", "get-url", "origin"], cwd=repo)
    if result.returncode != 0:
        print("WARN: origin remote is not configured.")
        return

    origin = result.stdout.strip()
    print(f"origin URL: {origin}")
    if expected_remote:
        if origin == expected_remote:
            print("OK: origin matches expected remote.")
        else:
            print(f"WARN: origin does not match expected remote: {expected_remote}")
    print("")


def object_size(repo: Path, oid: str) -> Optional[int]:
    result = run(["git", "cat-file", "-s", oid], cwd=repo)
    if result.returncode != 0:
        return None
    try:
        return int(result.stdout.strip())
    except ValueError:
        return None


def inspect_blob(repo: Path, oid: str) -> None:
    section(f"Blob Check: {oid}")
    type_result = run(["git", "cat-file", "-t", oid], cwd=repo)
    if type_result.returncode != 0:
        print("OK: blob/object is not present in this repository.")
        print("")
        return

    obj_type = type_result.stdout.strip()
    size = object_size(repo, oid)
    print(f"object type: {obj_type}")
    if size is not None:
        print(f"object size: {size} bytes")

    revs = run(["git", "rev-list", "--objects", "--all"], cwd=repo, check=True)
    matches = [line for line in revs.stdout.splitlines() if line.startswith(oid)]
    if matches:
        print("reachable paths:")
        for line in matches[:50]:
            print(f"  {line}")
        if len(matches) > 50:
            print(f"  ... {len(matches) - 50} more")
    else:
        print("NOTE: object exists, but no path was found via rev-list --objects --all.")
    print("")


def inspect_path(repo: Path, path: str) -> None:
    section(f"Path Check: {path}")
    command_block(["git", "ls-tree", "-r", "HEAD", "--", path], cwd=repo)
    result = run(["git", "rev-list", "--objects", "--all", "--", path], cwd=repo, check=True)
    object_lines = [line for line in result.stdout.splitlines() if line.strip()]
    print(f"historical objects for pathspec: {len(object_lines)}")
    for line in object_lines[:80]:
        print(line)
    if len(object_lines) > 80:
        print(f"... {len(object_lines) - 80} more")
    print("")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Check whether a repository is safe to use after git-compress."
    )
    parser.add_argument(
        "--expected-remote",
        default="https://github.com/cybergarage/cybergarage-pub.git",
        help="expected origin URL; use empty string to skip the comparison",
    )
    parser.add_argument(
        "--path",
        help="optional path to inspect across HEAD and history",
    )
    parser.add_argument(
        "--blob-id",
        help="optional blob/object ID to verify as present or removed",
    )
    parser.add_argument(
        "--no-sizer",
        action="store_true",
        help="skip git-sizer --verbose",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    repo = repo_root()
    expected_remote = args.expected_remote if args.expected_remote else None

    print("# git-compress repository check")
    print("")
    print(f"repository: {repo}")

    section("Working Tree")
    command_block(["git", "status"], cwd=repo)

    section("Recent Commits")
    command_block(["git", "log", "--oneline", "-5"], cwd=repo)

    section("Remote")
    command_block(["git", "remote", "-v"], cwd=repo)
    print_remote_check(repo, expected_remote)

    section("Repository Size")
    command_block(["du", "-sh", ".git"], cwd=repo)
    command_block(["git", "count-objects", "-vH"], cwd=repo)

    section("Reference Summary")
    print_ref_summary(repo)

    if args.path:
        inspect_path(repo, args.path)

    if args.blob_id:
        inspect_blob(repo, args.blob_id)

    if not args.no_sizer:
        section("git-sizer")
        if command_exists("git-sizer"):
            command_block(["git-sizer", "--verbose"], cwd=repo)
        else:
            print("WARN: git-sizer is not installed or not on PATH.")
            print("      Install it if you need the final size report.")
            print("")

    print("## Reading The Result")
    print("")
    print("- OK for daily work: status is clean and origin points to the expected repository.")
    print("- Likely rewritten/fresh: refs are small, with no stash/codex/other refs.")
    print("- Not rewritten: git-sizer still reports old large blobs or many extra refs.")
    print("- If checking a removed blob, --blob-id should say it is not present.")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except RuntimeError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        raise SystemExit(1)
